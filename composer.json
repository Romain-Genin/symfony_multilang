{
    "name": "romain-genin/symfony-multilang-bundle",
    "description": "Symfony bundle for multilingual sites: pre-filled translations (14 languages), LTR/RTL handling, locale-prefixed URLs and a Tailwind + Alpine.js language switcher Twig component.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "bundle",
        "i18n",
        "translation",
        "locale",
        "rtl",
        "twig-component",
        "tailwind",
        "alpinejs"
    ],
    "require": {
        "php": ">=8.2",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/filesystem": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/routing": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation": "^6.4 || ^7.0 || ^8.0",
        "symfony/twig-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/ux-twig-component": "^2.13 || ^3.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0",
        "twig/twig": "^3.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "symfony/browser-kit": "^6.4 || ^7.0 || ^8.0",
        "symfony/css-selector": "^6.4 || ^7.0 || ^8.0",
        "symfony/dom-crawler": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "RomainGenin\\MultiLangBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RomainGenin\\MultiLangBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        }
    },
    "suggest": {
        "romain-genin/symfony-ecom": "E-commerce bundle: its pages follow the locale chosen with the switcher"
    }
}
